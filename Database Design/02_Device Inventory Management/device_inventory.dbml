// Canonical inventory schema. SQL has the executable CHECK constraints and partial indexes.

Table credential_profiles {
  id uuid [pk]
  name varchar(100) [not null, unique]
  username varchar(100)
  password_encrypted text
  enable_secret_encrypted text
  snmp_community_ro_encrypted text
  ssh_port integer [not null, default: 22]
  snmp_port integer [not null, default: 161]
  description text
  created_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table sites {
  id uuid [pk]
  name varchar(100) [not null, unique]
  location_detail varchar(255)
  description text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table device_groups {
  id uuid [pk]
  name varchar(100) [not null, unique]
  color_tag varchar(7)
  description text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table devices {
  id uuid [pk]
  management_ip inet [unique, note: 'Verified collectable address; nullable for LLDP-only inventory']
  advertised_management_ip inet [note: 'LLDP-advertised only']
  hostname varchar(255)
  device_type varchar(20) [not null, default: 'unknown']
  role varchar(30)
  vendor varchar(50)
  model varchar(100)
  os_version varchar(100)
  serial_number varchar(100)
  chassis_id_subtype smallint
  chassis_id text
  site_id uuid
  credential_profile_id uuid
  platform varchar(50)
  management_state varchar(20) [not null, default: 'active']
  reachability varchar(20) [not null, default: 'unknown']
  enrollment_source varchar(30) [not null]
  last_seen_at timestamptz
  reachability_checked_at timestamptz
  last_collected_at timestamptz [not null]
  notes text
  created_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    site_id
    credential_profile_id
    hostname
    (chassis_id, chassis_id_subtype) [unique, name: 'uq_devices_active_chassis_identity']
  }
}

Table device_group_members {
  device_id uuid
  group_id uuid
  added_at timestamptz [not null]

  indexes {
    (device_id, group_id) [pk]
    group_id
  }
}

Table device_interfaces {
  id uuid [pk]
  device_id uuid [not null]
  if_index integer
  name varchar(255) [not null]
  mac_address macaddr
  description varchar(255)
  mode varchar(20) [not null, default: 'unknown']
  access_vlan_id integer
  admin_status varchar(20) [not null, default: 'unknown']
  oper_status varchar(20) [not null, default: 'unknown']
  speed_bps bigint
  collected_at timestamptz [not null]
  retired_at timestamptz
  updated_at timestamptz [not null]

  indexes {
    (device_id, id) [unique]
    (device_id, if_index) [unique, name: 'uq_interface_current_index']
    (device_id, name) [unique, name: 'uq_interface_current_name']
  }
}

Table interface_ip_addresses {
  interface_id uuid
  address inet

  indexes {
    (interface_id, address) [pk]
  }
}

Table config_versions {
  id uuid [pk]
  device_id uuid [not null]
  version integer [not null]
  content text [not null]
  message varchar(255) [not null]
  created_at timestamptz [not null]
}

Ref: devices.site_id > sites.id
Ref: devices.credential_profile_id > credential_profiles.id
Ref: device_group_members.device_id > devices.id
Ref: device_group_members.group_id > device_groups.id
Ref: device_interfaces.device_id > devices.id
Ref: interface_ip_addresses.interface_id > device_interfaces.id
Ref: config_versions.device_id > devices.id
