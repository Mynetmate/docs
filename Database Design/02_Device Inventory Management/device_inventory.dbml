// =============================================================================
// DBML Schema: 02_Device Inventory Management (3NF Normalized)
// Scope: Master Device Inventory, Credential Profiles, Sites, Groups & Interfaces
// Usage: Copy-paste to https://dbdiagram.io to visualize instantly!
// =============================================================================

Enum device_type_enum {
  router
  switch
  firewall
  access_point
  server
  other
}

Enum device_role_enum {
  core
  distribution
  access
  edge_router
  management
  other
}

Enum vendor_enum {
  cisco
  mikrotik
  huawei
  juniper
  arista
  linux
  unknown
}

Enum device_status_enum {
  online
  offline
  unreachable
  maintenance
}

Enum enrollment_status_enum {
  pending
  enrolled
  failed
  rejected
}

Enum discovery_method_enum {
  manual_enrollment
  auto_discovery
  csv_import
}

Enum credential_type_enum {
  ssh_password
  ssh_key
  snmp_v2c
  snmp_v3
  api_token
}

Enum interface_status_enum {
  Up
  Down
  Testing
  Unknown
}

Enum interface_mode_enum {
  access
  trunk
  routed
  loopback
  svi
  unknown
}

Enum enrollment_attempt_status_enum {
  pending
  authenticating
  collecting
  succeeded
  failed
}

// -----------------------------------------------------------------------------
// Table: credential_profiles (Encrypted Device Access Secrets)
// -----------------------------------------------------------------------------
Table credential_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null, unique]
  credential_type credential_type_enum [not null, default: 'ssh_password']
  username varchar(100)
  password_encrypted text
  enable_secret_encrypted text
  snmp_community_ro_encrypted text
  snmp_community_rw_encrypted text
  ssh_port integer [not null, default: 22]
  snmp_port integer [not null, default: 161]
  description text
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    name [name: 'idx_credential_profiles_name']
    credential_type [name: 'idx_credential_profiles_type']
  }
}

// -----------------------------------------------------------------------------
// Table: sites (Physical Locations)
// -----------------------------------------------------------------------------
Table sites {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null, unique]
  location_detail varchar(255)
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    name [name: 'idx_sites_name']
  }
}

// -----------------------------------------------------------------------------
// Table: device_groups (Organizational & Functional Groups)
// -----------------------------------------------------------------------------
Table device_groups {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null, unique]
  color_tag varchar(20) [default: '#3B82F6']
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    name [name: 'idx_device_groups_name']
  }
}

// -----------------------------------------------------------------------------
// Table: devices (Core Entity - System of Record)
// -----------------------------------------------------------------------------
Table devices {
  id uuid [pk, default: `gen_random_uuid()`]
  management_ip inet [not null, unique]
  hostname varchar(255) [not null]
  domain_name varchar(255)
  description text
  device_type device_type_enum [not null, default: 'switch']
  role device_role_enum [not null, default: 'access']
  vendor vendor_enum [not null, default: 'unknown']
  model varchar(100)
  os_version varchar(100)
  serial_number varchar(100)
  chassis_mac macaddr
  chassis_id varchar(100)
  site_id uuid [ref: > sites.id]
  credential_profile_id uuid [ref: > credential_profiles.id]
  platform varchar(50) [default: 'cisco_ios']
  management_vlan integer
  default_gateway inet
  is_managed boolean [not null, default: true]
  status device_status_enum [not null, default: 'online']
  enrollment_status enrollment_status_enum [not null, default: 'enrolled']
  discovery_method discovery_method_enum [not null, default: 'manual_enrollment']
  last_discovered_at timestamptz [default: `now()`]
  last_seen_at timestamptz [default: `now()`]
  last_collected_at timestamptz [default: `now()`]
  uptime_seconds bigint
  notes text
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    management_ip [name: 'idx_devices_mgmt_ip']
    hostname [name: 'idx_devices_hostname']
    vendor [name: 'idx_devices_vendor']
    device_type [name: 'idx_devices_type']
    role [name: 'idx_devices_role']
    status [name: 'idx_devices_status']
    site_id [name: 'idx_devices_site_id']
    credential_profile_id [name: 'idx_devices_cred_id']
  }
}

// -----------------------------------------------------------------------------
// Table: device_group_members (Many-to-Many Bridge)
// -----------------------------------------------------------------------------
Table device_group_members {
  device_id uuid [not null, ref: > devices.id]
  group_id uuid [not null, ref: > device_groups.id]
  added_at timestamptz [not null, default: `now()`]

  indexes {
    (device_id, group_id) [pk]
    device_id [name: 'idx_group_members_device']
    group_id [name: 'idx_group_members_group']
  }
}

// -----------------------------------------------------------------------------
// Table: device_interfaces (Ports / L2 & L3 Interfaces)
// -----------------------------------------------------------------------------
Table device_interfaces {
  id uuid [pk, default: `gen_random_uuid()`]
  device_id uuid [not null, ref: > devices.id]
  if_index integer [not null]
  name varchar(255) [not null]
  mac_address macaddr
  ip_address inet
  subnet_mask inet
  description varchar(255)
  mode interface_mode_enum [not null, default: 'access']
  vlan_id integer
  admin_status interface_status_enum [not null, default: 'Up']
  oper_status interface_status_enum [not null, default: 'Up']
  speed_bps bigint
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (device_id, if_index) [unique, name: 'uq_device_if_index']
    device_id [name: 'idx_interfaces_device_id']
    mac_address [name: 'idx_interfaces_mac']
    ip_address [name: 'idx_interfaces_ip']
    oper_status [name: 'idx_interfaces_oper_status']
  }
}

// -----------------------------------------------------------------------------
// Table: device_enrollment_attempts (Audit Trail of Manual Connection Tests)
// -----------------------------------------------------------------------------
Table device_enrollment_attempts {
  id uuid [pk, default: `gen_random_uuid()`]
  target_ip inet [not null]
  credential_profile_id uuid [ref: > credential_profiles.id]
  status enrollment_attempt_status_enum [not null, default: 'pending']
  error_message text
  collected_hostname varchar(255)
  collected_vendor varchar(50)
  collected_model varchar(100)
  collected_os_version varchar(100)
  duration_ms integer
  initiated_by uuid
  attempted_at timestamptz [not null, default: `now()`]

  indexes {
    target_ip [name: 'idx_enrollment_attempts_ip']
    status [name: 'idx_enrollment_attempts_status']
    attempted_at [name: 'idx_enrollment_attempts_time']
  }
}
