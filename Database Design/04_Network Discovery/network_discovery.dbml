// Canonical discovery schema. Tables from Device Inventory are expanded here
// because discovery references them; validation constraints live in the backend.

Table credential_profiles {
  id uuid [pk]
  name varchar(100) [not null, unique]
  username varchar(100)
  password_encrypted text
  enable_secret_encrypted text
  snmp_community_ro_encrypted text
  ssh_port integer [not null, default: 22]
  snmp_port integer [not null, default: 161]
  description text
  created_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table devices {
  id uuid [pk]
  management_ip inet [unique, note: 'Verified collectable address; nullable for LLDP-only inventory']
  advertised_management_ip inet [note: 'LLDP-advertised only']
  hostname varchar(255)
  device_type varchar(20) [not null, default: 'unknown']
  role varchar(30)
  vendor varchar(50)
  model varchar(100)
  os_version varchar(100)
  serial_number varchar(100)
  chassis_id_subtype smallint
  chassis_id text
  site_id uuid
  credential_profile_id uuid
  platform varchar(50)
  management_state varchar(20) [not null, default: 'active']
  reachability varchar(20) [not null, default: 'unknown']
  enrollment_source varchar(30) [not null]
  last_seen_at timestamptz
  reachability_checked_at timestamptz
  last_collected_at timestamptz [not null]
  notes text
  created_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table device_interfaces {
  id uuid [pk]
  device_id uuid [not null]
  if_index integer
  name varchar(255) [not null]
  mac_address macaddr
  description varchar(255)
  mode varchar(20) [not null, default: 'unknown']
  access_vlan_id integer
  admin_status varchar(20) [not null, default: 'unknown']
  oper_status varchar(20) [not null, default: 'unknown']
  speed_bps bigint
  collected_at timestamptz [not null]
  retired_at timestamptz
  updated_at timestamptz [not null]
}

Table discovery_scans {
  id uuid [pk]
  seed_ip inet [not null]
  credential_profile_id uuid [not null]
  status varchar(20) [not null, default: 'queued']
  timeout_seconds integer [not null, default: 2]
  max_depth integer [not null]
  max_devices integer [not null]
  environment varchar(20) [not null]
  initiated_by uuid
  error_message text
  requested_at timestamptz [not null]
  started_at timestamptz
  finished_at timestamptz

  indexes { requested_at }
}

Table collection_runs {
  id uuid [pk]
  discovery_scan_id uuid
  device_id uuid
  target_ip inet [not null]
  credential_profile_id uuid [not null]
  purpose varchar(30) [not null]
  transport varchar(20) [not null]
  environment varchar(20) [not null]
  status varchar(20) [not null, default: 'queued']
  neighbor_status varchar(20) [not null, default: 'not_attempted']
  initiated_by uuid
  error_message text
  requested_at timestamptz [not null]
  started_at timestamptz
  finished_at timestamptz

  indexes {
    (id, device_id) [unique]
    (device_id, requested_at)
    discovery_scan_id
    credential_profile_id
  }
}

Table neighbor_observations {
  id uuid [pk]
  collection_run_id uuid [not null]
  local_device_id uuid [not null]
  local_interface_id uuid [not null]
  observation_key varchar(255) [not null]
  protocol varchar(10) [not null, default: 'lldp']
  remote_chassis_id_subtype smallint
  remote_chassis_id text
  remote_port_id_subtype smallint
  remote_port_id text
  remote_system_name text
  remote_port_description text
  remote_management_ip inet [note: 'LLDP evidence only; not a verified management address']
  observed_at timestamptz [not null]

  indexes {
    (collection_run_id, observation_key) [unique]
    (local_device_id, local_interface_id)
    observed_at
  }
}

Table topology_default_routes {
  source_device_id uuid [pk]
  gateway_ip inet [note: 'Nullable for interface-only routes']
  gateway_hostname varchar(255) [not null, default: 'Default Gateway']
  source_interface_name varchar(255)
  observed_at timestamptz [not null]

  indexes { gateway_ip }
}

Ref: discovery_scans.credential_profile_id > credential_profiles.id
Ref: collection_runs.discovery_scan_id > discovery_scans.id
Ref: collection_runs.device_id > devices.id
Ref: collection_runs.credential_profile_id > credential_profiles.id
Ref: neighbor_observations.collection_run_id > collection_runs.id
Ref: neighbor_observations.local_device_id > devices.id
Ref: neighbor_observations.local_interface_id > device_interfaces.id
Ref: topology_default_routes.source_device_id > devices.id
